<UserControl x:Class="Soundpost.App.Views.AmbientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource BodyFont}">

    <Grid Margin="4,0,20,18">
        <Border Style="{StaticResource Card}" CornerRadius="16" Padding="20,16">
            <DockPanel>
                <!-- header -->
                <Grid DockPanel.Dock="Top" Margin="2,0,2,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="AMBIENT" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="Layer sounds into a backdrop for focus, sleep, or calm."
                                   Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Caption}"
                                   Text="{Binding ActiveCount, StringFormat='{}{0} playing'}" />
                        <Button Style="{StaticResource PillButton}" Content="Stop all" Command="{Binding StopAllCommand}"
                                Visibility="{Binding AnyActive, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>

                <!-- sound palette -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sounds}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="122" Margin="6,6,6,16" HorizontalAlignment="Center">
                                    <!-- circular play toggle -->
                                    <Button Style="{StaticResource ChipButton}" Margin="0" HorizontalAlignment="Center"
                                            Command="{Binding ToggleCommand}" ToolTip="{Binding Name}">
                                        <Border x:Name="circle" Width="76" Height="76" CornerRadius="38"
                                                Background="{StaticResource InsetBrush}"
                                                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1.5">
                                            <Path x:Name="glyph" Width="32" Height="32" Stretch="Uniform"
                                                  Data="{Binding IconKey, Converter={StaticResource GlyphKey}}"
                                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Button>

                                    <TextBlock x:Name="label" Text="{Binding Name}" HorizontalAlignment="Center"
                                               Margin="0,11,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                               FontFamily="{StaticResource LabelFont}" FontSize="12.5"
                                               Foreground="{StaticResource TextSecondaryBrush}" />

                                    <Slider x:Name="vol" Style="{StaticResource AppSlider}" Width="104" Margin="0,10,0,0"
                                            Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" Opacity="0.45" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="circle" Property="Background" Value="{StaticResource AccentFillBrush}" />
                                        <Setter TargetName="circle" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="glyph" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="label" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        <Setter TargetName="vol" Property="Opacity" Value="1" />
                                        <Setter TargetName="circle" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.55" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
