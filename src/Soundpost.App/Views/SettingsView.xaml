<UserControl x:Class="Soundpost.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource BodyFont}">
    <UserControl.Resources>
        <!-- A theme swatch: a preview of the palette plus its name; the active one gets an accent ring. -->
        <Style x:Key="ThemeCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ring" CornerRadius="14" BorderThickness="2" Padding="2"
                                BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4,0,20,18">
        <Border Style="{StaticResource Card}" CornerRadius="16" VerticalAlignment="Top">
            <StackPanel Margin="4">
                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="Theme" FontFamily="{StaticResource LabelFont}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,2" />
                <TextBlock Text="Reskins the whole console. The visualizer's own colours are set by its Palette knob and don't change."
                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16" MaxWidth="520" HorizontalAlignment="Left" />

                <WrapPanel>
                    <!-- Indigo (dark) -->
                    <RadioButton x:Name="ThemeIndigo" GroupName="Theme" Style="{StaticResource ThemeCard}" Checked="OnThemeChosen" Tag="Indigo">
                        <Border Width="176" CornerRadius="12" Background="#151B2E" BorderBrush="#242E48" BorderThickness="1" ClipToBounds="True">
                            <StackPanel>
                                <Grid Height="72">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="#0B0F1C" />
                                    <Rectangle Grid.Column="1" Fill="#1C2439" />
                                    <Rectangle Grid.Column="2" Fill="#FF8A3D" />
                                </Grid>
                                <TextBlock Text="Indigo" FontFamily="{StaticResource LabelFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="#EDF1FA" Margin="12,9,0,3" />
                                <TextBlock Text="Deep blue · orange" FontFamily="{StaticResource LabelFont}" FontSize="10.5" Foreground="#8B93A2" Margin="12,0,0,10" />
                            </StackPanel>
                        </Border>
                    </RadioButton>

                    <!-- Black & Red (dark) -->
                    <RadioButton x:Name="ThemeBlackRed" GroupName="Theme" Style="{StaticResource ThemeCard}" Checked="OnThemeChosen" Tag="BlackRed">
                        <Border Width="176" CornerRadius="12" Background="#161418" BorderBrush="#2A262D" BorderThickness="1" ClipToBounds="True">
                            <StackPanel>
                                <Grid Height="72">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="#0C0C0F" />
                                    <Rectangle Grid.Column="1" Fill="#302B31" />
                                    <Rectangle Grid.Column="2" Fill="#CA2422" />
                                </Grid>
                                <TextBlock Text="Black &amp; Red" FontFamily="{StaticResource LabelFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1EEF0" Margin="12,9,0,3" />
                                <TextBlock Text="Near-black · red" FontFamily="{StaticResource LabelFont}" FontSize="10.5" Foreground="#9C949B" Margin="12,0,0,10" />
                            </StackPanel>
                        </Border>
                    </RadioButton>

                    <!-- Rich — Gold &amp; White (light) -->
                    <RadioButton x:Name="ThemeRichGold" GroupName="Theme" Style="{StaticResource ThemeCard}" Checked="OnThemeChosen" Tag="RichGold">
                        <Border Width="176" CornerRadius="12" Background="#FFFFFF" BorderBrush="#DCD5C6" BorderThickness="1" ClipToBounds="True">
                            <StackPanel>
                                <Grid Height="72">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="#EDEAE2" />
                                    <Rectangle Grid.Column="1" Fill="#1C1810" />
                                    <Rectangle Grid.Column="2" Fill="#B8912E" />
                                </Grid>
                                <TextBlock Text="Rich Gold" FontFamily="{StaticResource LabelFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1C1810" Margin="12,9,0,3" />
                                <TextBlock Text="White · gold · black" FontFamily="{StaticResource LabelFont}" FontSize="10.5" Foreground="#6B6353" Margin="12,0,0,10" />
                            </StackPanel>
                        </Border>
                    </RadioButton>

                    <!-- Pink — Cherry Blossom (light) -->
                    <RadioButton x:Name="ThemePinkBlossom" GroupName="Theme" Style="{StaticResource ThemeCard}" Checked="OnThemeChosen" Tag="PinkBlossom">
                        <Border Width="176" CornerRadius="12" Background="#FFFFFF" BorderBrush="#F0D9DF" BorderThickness="1" ClipToBounds="True">
                            <StackPanel>
                                <Grid Height="72">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="#FBF2F4" />
                                    <Rectangle Grid.Column="1" Fill="#14112D" />
                                    <Rectangle Grid.Column="2" Fill="#E75A84" />
                                </Grid>
                                <TextBlock Text="Cherry Blossom" FontFamily="{StaticResource LabelFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="#14112D" Margin="12,9,0,3" />
                                <TextBlock Text="Pink · navy · blush" FontFamily="{StaticResource LabelFont}" FontSize="10.5" Foreground="#6E667F" Margin="12,0,0,10" />
                            </StackPanel>
                        </Border>
                    </RadioButton>

                    <!-- Forest — Pine &amp; Amber (dark) -->
                    <RadioButton x:Name="ThemeForest" GroupName="Theme" Style="{StaticResource ThemeCard}" Checked="OnThemeChosen" Tag="Forest">
                        <Border Width="176" CornerRadius="12" Background="#142418" BorderBrush="#23392A" BorderThickness="1" ClipToBounds="True">
                            <StackPanel>
                                <Grid Height="72">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="#0B120D" />
                                    <Rectangle Grid.Column="1" Fill="#1B2E20" />
                                    <Rectangle Grid.Column="2" Fill="#E0A33A" />
                                </Grid>
                                <TextBlock Text="Forest" FontFamily="{StaticResource LabelFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="#EAF2EC" Margin="12,9,0,3" />
                                <TextBlock Text="Pine · amber" FontFamily="{StaticResource LabelFont}" FontSize="10.5" Foreground="#97AC9E" Margin="12,0,0,10" />
                            </StackPanel>
                        </Border>
                    </RadioButton>
                </WrapPanel>

                <TextBlock Text="More themes are coming — this is the switcher they'll plug into."
                           Style="{StaticResource Caption}" Margin="0,18,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
