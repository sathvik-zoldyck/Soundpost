<UserControl x:Class="Soundpost.App.Views.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Soundpost.App.Controls"
             FontFamily="{StaticResource BodyFont}">
    <UserControl.Resources>
        <Style x:Key="DeviceCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF8A3D" BlurRadius="26" ShadowDepth="0" Opacity="0.35" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,4,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- scenes -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,16">
            <TextBlock Text="SCENES" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="Music" Style="{StaticResource PillButtonActive}" Margin="0,0,8,0" />
            <Button Content="Gaming" Style="{StaticResource PillButton}" Margin="0,0,8,0" />
            <Button Content="Movie Night" Style="{StaticResource PillButton}" Margin="0,0,8,0" />
            <Button Content="Meeting" Style="{StaticResource PillButton}" Margin="0,0,8,0" />
            <Button Content="Night" Style="{StaticResource PillButton}" />
        </StackPanel>

        <!-- body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="178" />
            </Grid.ColumnDefinitions>

            <!-- output devices -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="OUTPUT DEVICES" Style="{StaticResource SectionLabel}" Margin="2,0,0,12" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PlaybackDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DeviceCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding State}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Switch" Style="{StaticResource SwitchButton}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisInv}}"
                                                Command="{Binding DataContext.SetDefaultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="8"
                                                Padding="10,5" VerticalAlignment="Center"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Default" FontFamily="{StaticResource LabelFont}" FontSize="10.5"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- app mixer -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="APP MIXER" Style="{StaticResource SectionLabel}" Margin="2,0,0,12" />
                <Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Sessions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Background="{StaticResource StripBrush}"
                                            Width="110" Margin="0,0,11,0" Padding="12,12,12,11" CornerRadius="16">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource SurfaceAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName, Converter={StaticResource FirstLetter}}"
                                                           FontFamily="{StaticResource LabelFont}" FontSize="16" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold" FontSize="12" Margin="0,7,0,0" MaxWidth="88"
                                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                            <StackPanel Orientation="Horizontal" Height="150" HorizontalAlignment="Center" Margin="0,10,0,0">
                                                <c:SegmentMeter Width="13" Segments="12" Level="{Binding MeterLevel}" Margin="0,0,8,0" />
                                                <Grid Width="16">
                                                    <TextBlock Text="0" Style="{StaticResource Mono}" FontSize="8" VerticalAlignment="Top" />
                                                    <TextBlock Text="-12" Style="{StaticResource Mono}" FontSize="8" VerticalAlignment="Center" />
                                                    <TextBlock Text="-40" Style="{StaticResource Mono}" FontSize="8" VerticalAlignment="Bottom" />
                                                </Grid>
                                                <Slider Style="{StaticResource ChannelFader}" Value="{Binding Volume, Mode=TwoWay}" />
                                            </StackPanel>

                                            <ToggleButton Style="{StaticResource MuteToggle}" Width="84" Margin="0,11,0,0"
                                                          IsChecked="{Binding IsMuted, Mode=TwoWay}" />
                                            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource Mono}">
                                                <Run Text="{Binding VolumePercent, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" /><Run Text=" %" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>

            <!-- master -->
            <Border Grid.Column="4" Style="{StaticResource Card}" Background="{StaticResource RaisedBrush}" Padding="12">
                <StackPanel>
                    <TextBlock Text="MASTER" Style="{StaticResource SectionLabel}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" Height="168" HorizontalAlignment="Center">
                        <c:SegmentMeter Width="12" Segments="14" Level="{Binding MasterLevel}" Margin="0,0,7,0" />
                        <c:SegmentMeter Width="12" Segments="14" Level="{Binding MasterLevel}" />
                    </StackPanel>
                    <Border Margin="0,14,0,0" Background="{StaticResource InsetBrush}" CornerRadius="11" Padding="11"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="OUTPUT" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding DefaultDeviceName}" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
