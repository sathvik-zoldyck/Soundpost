<UserControl x:Class="Soundpost.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource BodyFont}">
    <Grid Margin="4,0,20,18">
        <Border Style="{StaticResource Card}" CornerRadius="16">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <Border Width="62" Height="62" CornerRadius="18" HorizontalAlignment="Center"
                        Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Path Data="{StaticResource IconAutomation}" Width="26" Height="26" Stretch="Uniform"
                          Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Border>
                <TextBlock Text="{Binding ActiveSection}" FontFamily="{StaticResource LabelFont}" FontSize="22"
                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,18,0,0" />
                <TextBlock Style="{StaticResource Caption}" FontSize="12" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,9,0,0" LineHeight="18"
                           Text="This one's on the roadmap and isn't wired up yet. The console around it is live — Dashboard, Mixer and Visualizer all work today." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
