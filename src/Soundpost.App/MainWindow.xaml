<Window x:Class="Soundpost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Soundpost.App.Views"
        Title="Soundpost" Height="724" Width="1180" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource ChassisBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource BodyFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Tab" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Padding="16,7" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- caption -->
        <Grid Grid.Row="0" Margin="18,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- brand -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="34" Height="34">
                    <Canvas Width="512" Height="512">
                        <!-- left equalizer bars -->
                        <Rectangle Canvas.Left="60" Canvas.Top="206" Width="18" Height="100" RadiusX="9" RadiusY="9" Fill="#FF7A1A" />
                        <Rectangle Canvas.Left="96" Canvas.Top="181" Width="18" Height="150" RadiusX="9" RadiusY="9" Fill="#FF7A1A" />
                        <Rectangle Canvas.Left="132" Canvas.Top="161" Width="18" Height="190" RadiusX="9" RadiusY="9" Fill="#FF7A1A" />
                        <!-- right equalizer bars -->
                        <Rectangle Canvas.Left="362" Canvas.Top="161" Width="18" Height="190" RadiusX="9" RadiusY="9" Fill="#A24BFF" />
                        <Rectangle Canvas.Left="398" Canvas.Top="181" Width="18" Height="150" RadiusX="9" RadiusY="9" Fill="#A24BFF" />
                        <Rectangle Canvas.Left="434" Canvas.Top="206" Width="18" Height="100" RadiusX="9" RadiusY="9" Fill="#A24BFF" />
                        <!-- interlocking S -->
                        <Path StrokeThickness="42" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 336 176 C 296 148, 212 158, 212 202 C 212 236, 256 248, 256 256 C 256 264, 300 276, 300 310 C 300 354, 216 364, 176 336">
                            <Path.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF7A1A" Offset="0" />
                                    <GradientStop Color="#FF3D7F" Offset="0.5" />
                                    <GradientStop Color="#A24BFF" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Stroke>
                        </Path>
                    </Canvas>
                </Viewbox>
                <TextBlock Margin="11,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource LabelFont}" FontSize="15" FontWeight="SemiBold">
                    <Run Text="SOUND" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="POST" Foreground="{StaticResource AccentBrush}" />
                </TextBlock>
            </StackPanel>

            <!-- tabs -->
            <Border Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" CornerRadius="10"
                    Background="#0F1218" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="3"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Mixer" Command="{Binding ShowMixerCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Tab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowVisualizer}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource AccentFillBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Visualizer" Command="{Binding ShowVisualizerViewCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Tab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowVisualizer}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentFillBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- now -->
            <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0"
                       Style="{StaticResource Caption}" Text="{Binding DefaultDeviceName, StringFormat='OUTPUT · {0}'}" />

            <!-- window buttons -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" FontFamily="Segoe MDL2 Assets" FontSize="10" Content="&#xE921;" />
                <Button Style="{StaticResource CaptionButton}" Click="OnClose" FontFamily="Segoe MDL2 Assets" FontSize="10" Content="&#xE8BB;" />
            </StackPanel>
        </Grid>

        <!-- content -->
        <Grid Grid.Row="1">
            <views:MixerView Visibility="{Binding ShowVisualizer, Converter={StaticResource BoolToVisInv}}" />
            <views:VisualizerView Visibility="{Binding ShowVisualizer, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</Window>
