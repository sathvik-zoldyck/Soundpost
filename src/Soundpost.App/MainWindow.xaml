<Window x:Class="Soundpost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soundpost" Height="640" Width="980" MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================ Header ============================ -->
        <Grid Grid.Row="0" Margin="4,0,4,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="🎛" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Soundpost" Style="{StaticResource H1}" />
                    <TextBlock Text="A mixing desk for your whole PC" Style="{StaticResource Caption}" />
                </StackPanel>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="CURRENT OUTPUT" Style="{StaticResource SectionTitle}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding DefaultDeviceName}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"
                           MaxWidth="360" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- ============================ Body ============================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Output devices -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="OUTPUT DEVICES" Style="{StaticResource SectionTitle}"
                           Margin="4,0,0,10" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PlaybackDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding State}" Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource DefaultBadge}">
                                            <TextBlock Text="Default" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                        <Button Grid.Column="1" Content="Switch" Style="{StaticResource SwitchButton}"
                                                Command="{Binding DataContext.SetDefaultCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- App mixer -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="APP MIXER" Style="{StaticResource SectionTitle}"
                           Margin="4,0,0,10" />
                <Grid>
                    <TextBlock Text="No apps are playing audio right now.&#x0a;Start some music or a video and it will appear here."
                               TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Sessions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VolumePercent}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="8,0,2,0" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="%"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" />

                                            <Slider Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                    Style="{StaticResource VolumeSlider}"
                                                    Value="{Binding Volume, Mode=TwoWay}" Margin="0,10,10,0" />
                                            <ToggleButton Grid.Row="1" Grid.Column="2" Style="{StaticResource MuteToggle}"
                                                          IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                          VerticalAlignment="Center" Margin="0,10,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
