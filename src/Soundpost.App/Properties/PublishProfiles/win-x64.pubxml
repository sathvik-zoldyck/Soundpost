<?xml version="1.0" encoding="utf-8"?>
<!--
  One-file, self-contained Windows build: a single Soundpost.exe that runs on a clean Windows 10/11
  machine with no .NET install. Produce it with:

      dotnet publish src/Soundpost.App/Soundpost.App.csproj -p:PublishProfile=win-x64

  The release workflow uses this same profile, so local and CI builds are identical.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- No PDBs in the shipped artifact — keep the download to the one executable. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
