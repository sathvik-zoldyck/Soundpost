<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Soundpost.App</RootNamespace>
    <AssemblyName>Soundpost</AssemblyName>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The brand mark, embedded so the window and rail can render it without a file on disk.
         logo.png is the source art (opaque black background); logo-mark.png is the same mark with
         alpha derived from its brightness, so it sits on any surface without a black tile. -->
    <Resource Include="Assets\logo-mark.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Soundpost.Core.Audio\Soundpost.Core.Audio.csproj" />
    <ProjectReference Include="..\Soundpost.Core.Storage\Soundpost.Core.Storage.csproj" />
  </ItemGroup>

</Project>
