<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ Fonts ============================ -->
    <FontFamily x:Key="LabelFont">Bahnschrift, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Code, Consolas</FontFamily>

    <!-- ============================ Palette ============================
         All theme-varying colour (surfaces, accent, text, gradients, the visualiser screen backdrop)
         lives in the theme dictionaries — Themes/ThemeIndigo.xaml and Themes/ThemeBlackRed.xaml —
         which are merged ahead of this one and swapped at runtime from Settings. The styles below
         reference those keys, so a theme swap reskins the whole app without touching them. -->

    <!-- Shared motion timings — quick enough to feel responsive, slow enough to read. -->
    <Duration x:Key="FastFade">0:0:0.13</Duration>
    <Duration x:Key="MedFade">0:0:0.20</Duration>

    <!-- ============================ Text ============================ -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>

    <!-- ============================ Card ============================ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BevelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="13" />
        <Setter Property="Effect">
            <Setter.Value>
                <!-- Reads as separation from the bed, not as a visible shadow. -->
                <DropShadowEffect Color="#04060C" BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.75" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Buttons ============================ -->
    <Style x:Key="SwitchButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="9" Padding="12,7" BorderThickness="1"
                            BorderBrush="{StaticResource BorderSoftBrush}" Background="{StaticResource SurfaceAltBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="10" Padding="14,8" BorderThickness="1">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource SurfaceAltColor}" />
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource BorderSoftColor}" />
                        </Border.BorderBrush>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="{StaticResource AccentColor}" Duration="{StaticResource FastFade}" />
                                        <ColorAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="Background.Color"
                                                        To="{StaticResource SurfaceHighColor}" Duration="{StaticResource FastFade}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="{StaticResource BorderSoftColor}" Duration="{StaticResource FastFade}" />
                                        <ColorAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="Background.Color"
                                                        To="{StaticResource SurfaceAltColor}" Duration="{StaticResource FastFade}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillButtonActive" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="10" Padding="14,8" Background="{StaticResource AccentFillBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window caption buttons -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="7" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Mute toggle ============================ -->
    <Style x:Key="MuteToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" CornerRadius="8" Padding="0,7"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                        <TextBlock x:Name="t" Text="Mute" FontFamily="{StaticResource LabelFont}" FontSize="10.5"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentFillBrush}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="t" Property="Text" Value="Muted" />
                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Solo: same shape as MuteToggle, its own label. Highlights when this app is the soloed one. -->
    <Style x:Key="SoloToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" CornerRadius="8" Padding="0,7"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                        <TextBlock x:Name="t" Text="Solo" FontFamily="{StaticResource LabelFont}" FontSize="10.5"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentFillBrush}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="t" Property="Text" Value="Soloed" />
                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Naked click surface for the route pills. The pill's chrome + glyph live in the item template
         (they react to the endpoint's IconKind and pinned state), so this only carries the command. -->
    <Style x:Key="ChipButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,7,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

