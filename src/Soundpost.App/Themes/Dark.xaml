<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ Fonts ============================ -->
    <FontFamily x:Key="LabelFont">Bahnschrift, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Code, Consolas</FontFamily>

    <!-- ============================ Palette ============================ -->
    <SolidColorBrush x:Key="ChassisTopBrush" Color="#191D25" />
    <SolidColorBrush x:Key="BgBrush" Color="#0C0E12" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#171B22" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1A1E26" />
    <SolidColorBrush x:Key="InsetBrush" Color="#070A0D" />
    <SolidColorBrush x:Key="BorderBrush" Color="#242A34" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#2B313D" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EEF1F7" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B93A2" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#586070" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF8A3D" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFB072" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#26FF7A1A" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#1A1206" />
    <SolidColorBrush x:Key="VioletBrush" Color="#8B7BFF" />

    <LinearGradientBrush x:Key="ChassisBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#191D25" Offset="0" />
        <GradientStop Color="#0F1217" Offset="0.55" />
        <GradientStop Color="#0A0C10" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RaisedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A1E26" Offset="0" />
        <GradientStop Color="#14171E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StripBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#171B22" Offset="0" />
        <GradientStop Color="#0E1116" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFBE86" Offset="0" />
        <GradientStop Color="#FF8A3D" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================ Text ============================ -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>

    <!-- ============================ Card ============================ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="13" />
    </Style>

    <!-- ============================ Buttons ============================ -->
    <Style x:Key="SwitchButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="9" Padding="12,7" BorderThickness="1"
                            BorderBrush="{StaticResource BorderSoftBrush}" Background="{StaticResource SurfaceAltBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="10" Padding="14,8" BorderThickness="1"
                            BorderBrush="{StaticResource BorderSoftBrush}" Background="{StaticResource SurfaceAltBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillButtonActive" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="10" Padding="14,8" Background="{StaticResource AccentFillBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF8A3D" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window caption buttons -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="7" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Mute toggle ============================ -->
    <Style x:Key="MuteToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" CornerRadius="8" Padding="0,7"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                        <TextBlock x:Name="t" Text="Mute" FontFamily="{StaticResource LabelFont}" FontSize="10.5"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentFillBrush}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="t" Property="Text" Value="Muted" />
                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Channel fader (vertical) ============================ -->
    <Style x:Key="ChannelFader" TargetType="Slider">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Width="30">
                        <Border Width="6" CornerRadius="3" Background="{StaticResource InsetBrush}"
                                BorderBrush="#1E232C" BorderThickness="1" HorizontalAlignment="Center" Margin="0,8" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Focusable="False" IsTabStop="False" Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Width="6" CornerRadius="3" Background="{StaticResource AccentFillBrush}"
                                                    HorizontalAlignment="Center" Margin="0,8">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#FF8A3D" BlurRadius="10" ShadowDepth="0" Opacity="0.5" />
                                                </Border.Effect>
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Focusable="False" IsTabStop="False" Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="28" Height="16" CornerRadius="5" BorderThickness="1" BorderBrush="#49505C">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#3D444F" Offset="0" />
                                                        <GradientStop Color="#20252E" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border Height="2" Width="16" CornerRadius="1" Background="#11141A" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
