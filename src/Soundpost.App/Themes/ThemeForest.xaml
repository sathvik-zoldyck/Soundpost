<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ Forest — Pine & Amber ============================
         A dark scheme built on a pine-green luminance ladder, with a warm honey-amber accent that
         reads like light through a canopy. Same shape as the Indigo theme (dark surfaces, one warm
         accent), a different hue family. All theme-varying colour lives here; the styles in Dark.xaml
         reference these keys, so swapping this dictionary reskins the whole app. -->

    <Color x:Key="ChassisColor">#0B120D</Color>
    <Color x:Key="SurfaceColor">#142418</Color>
    <Color x:Key="SurfaceAltColor">#1B2E20</Color>
    <Color x:Key="SurfaceHighColor">#23392A</Color>
    <Color x:Key="AccentColor">#E0A33A</Color>
    <Color x:Key="AccentSoftColor">#33E0A33A</Color>
    <Color x:Key="TransparentColor">#00000000</Color>
    <Color x:Key="BorderColor">#23392A</Color>
    <Color x:Key="BorderSoftColor">#33513C</Color>

    <SolidColorBrush x:Key="ChassisTopBrush" Color="#131F16" />
    <SolidColorBrush x:Key="BgBrush" Color="#0B120D" />
    <SolidColorBrush x:Key="RailBrush" Color="#090F0B" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#142418" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1B2E20" />
    <SolidColorBrush x:Key="SurfaceHighBrush" Color="#23392A" />
    <SolidColorBrush x:Key="InsetBrush" Color="#060A07" />
    <SolidColorBrush x:Key="BorderBrush" Color="#23392A" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#33513C" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EAF2EC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#97AC9E" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#647A6C" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E0A33A" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F0BE68" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#33E0A33A" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#1A1305" />
    <SolidColorBrush x:Key="VioletBrush" Color="#7FA06A" />

    <LinearGradientBrush x:Key="ChassisBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#111C13" Offset="0" />
        <GradientStop Color="#0B120D" Offset="0.45" />
        <GradientStop Color="#080D09" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RaisedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A2A1F" Offset="0" />
        <GradientStop Color="#142118" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BevelBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3B5A44" Offset="0" />
        <GradientStop Color="#2A4130" Offset="0.35" />
        <GradientStop Color="#1E2F23" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StripBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B2E20" Offset="0" />
        <GradientStop Color="#132017" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F0BE68" Offset="0" />
        <GradientStop Color="#E0A33A" Offset="1" />
    </LinearGradientBrush>

    <!-- Visualizer screen backdrop + grid (the visualiser's OWN colours are separate and unchanged). -->
    <RadialGradientBrush x:Key="ScreenBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.75" RadiusY="0.9">
        <GradientStop Color="#101B12" Offset="0" />
        <GradientStop Color="#090F0A" Offset="0.7" />
        <GradientStop Color="#060906" Offset="1" />
    </RadialGradientBrush>
    <Color x:Key="GridColor">#14251A</Color>

</ResourceDictionary>
